# Google Gemini API Configuration (Required)
GEMINI_API_KEY=your_gemini_api_key_here
MODEL_NAME=gemini-3.8-flash

# Steam Integration (Optional for /gaming and /steam modes)
STEAM_API_KEY=your_steam_web_api_key_here
STEAM_ID=your_64bit_steam_id_here

# External Search Fallback (Optional)
TAVILY_API_KEY=your_tavily_api_key_here

# Sandbox Configuration (Optional)
# SANDBOX_ENGINE=auto        # auto, docker, or podman
# SANDBOX_IMAGE=archlinux:latest
# SANDBOX_MEMORY=512m
# SANDBOX_CPU_QUOTA=50000    # 50% CPU limit
# SANDBOX_PIDS_LIMIT=256     # Fork bomb protection
# SANDBOX_NETWORK=bridge     # bridge or none
# SANDBOX_TIMEOUT=30         # Command execution timeout in seconds
# SANDBOX_READ_ONLY=false    # Mount workspace read-only for isolation
